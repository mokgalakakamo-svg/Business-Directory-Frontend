BUSINESS_API_KEY=replace_with_a_long_random_secret

# Local SQLite development mode; the API creates tables when it starts.
DATABASE_URL=sqlite:///./business_directory.sqlite3
AUTO_CREATE_TABLES=true

# For PostgreSQL, remove DATABASE_URL and AUTO_CREATE_TABLES and set:
# DB_USER=your_database_user
# DB_PASSWORD=your_database_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=your_database_name
